# PostgreSQL configuration
# Replace the placeholder below with your real connection string for deployment.
# Do NOT commit secrets to version control. Keep secrets in your local `.env.local`
DATABASE_URL=postgresql://username:password@your-server:5432/your-database

# SMTP Configuration for email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT Secret for authentication
JWT_SECRET=your-secure-jwt-secret